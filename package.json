{
	"name": "browse",
	"version": "4.0.0",
	"description": "Adds commands that let you quickly browse editor-related folders or reveal files you're working on",
	"scripts": {
		"build": "tsdown",
		"dev": "npm run build -- --watch",
		"lint": "concurrently --prefix-colors blue,green,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze",
		"prepublishOnly": "npm run build",
		"start": "npm run dev",
		"test": "npm run lint"
	},
	"type": "commonjs",
	"main": "./lib/index.cjs",
	"types": "./lib/index.d.cts",
	"keywords": [],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/atom-browse.git"
	},
	"homepage": "https://web.pulsar-edit.dev/packages/browse",
	"bugs": {
		"url": "https://github.com/idleberg/atom-browse/issues"
	},
	"license": "MIT",
	"engines": {
		"atom": ">=1.52.0 <2.0.0",
		"pulsar": ">=1.102.0 <2.0.0"
	},
	"activationHooks": [
		"core:loaded-shell-environment"
	],
	"providedServices": {
		"browse": {
			"description": "Opens files/folders in your file manager",
			"versions": {
				"2.0.0": "provideBrowse"
			}
		}
	},
	"dependencies": {
		"@atxm/developer-console": "^0.6.1",
		"atom-package-deps": "^8.0.0",
		"find-up": "^5.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@idleberg/configs": "^0.4.5",
		"@pulsar-edit/types": "^1.131.0",
		"@types/node": "^14.18.63",
		"concurrently": "^10.0.3",
		"log-symbols": "^5.1.0",
		"tsdown": "^0.22.2",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3"
	}
}
